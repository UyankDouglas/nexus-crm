// NEXUS CRM — modelo de dados
// Convenções: tabelas e colunas em snake_case, IDs UUIDv7 (ordenáveis por tempo),
// datas com fuso horário (timestamptz) e toda entidade de negócio ligada a uma organização.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  ADMIN
  MANAGER
  SALES

  @@map("member_role")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum CustomerType {
  COMPANY
  PERSON

  @@map("customer_type")
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

enum StageKind {
  OPEN
  WON
  LOST

  @@map("stage_kind")
}

enum DealStatus {
  OPEN
  WON
  LOST

  @@map("deal_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH

  @@map("task_priority")
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE

  @@map("activity_type")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String    @db.VarChar(120)
  /// Sempre armazenado em minúsculas (normalizado na camada de aplicação).
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         OrganizationMember[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  createdCustomers    Customer[]           @relation("CustomerCreatedBy")
  createdDeals        Deal[]               @relation("DealCreatedBy")
  dealHistoryChanges  DealStageHistory[]   @relation("DealHistoryChangedBy")
  createdTasks        Task[]               @relation("TaskCreatedBy")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members    OrganizationMember[]
  sessions   Session[]
  customers  Customer[]
  contacts   Contact[]
  pipelines  Pipeline[]
  deals      Deal[]
  tasks      Task[]
  activities Activity[]

  @@map("organizations")
}

/// Vínculo usuário ↔ organização. É a única fonte de autorização multi-tenant:
/// um usuário só acessa dados de organizações em que possui vínculo ATIVO.
model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MemberRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedCustomers Customer[]   @relation("CustomerOwner")
  ownedDeals     Deal[]       @relation("DealOwner")
  assignedTasks  Task[]       @relation("TaskAssignee")
  activities     Activity[]   @relation("ActivityAuthor")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

/// Sessão server-side. O cookie HttpOnly carrega apenas um token aleatório;
/// o banco guarda somente o hash SHA-256, permitindo expiração e revogação.
model Session {
  id                   String    @id @default(uuid(7)) @db.Uuid
  tokenHash            String    @unique @map("token_hash") @db.Char(64)
  userId               String    @map("user_id") @db.Uuid
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  ipAddress            String?   @map("ip_address") @db.VarChar(64)
  userAgent            String?   @map("user_agent") @db.VarChar(512)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt           DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Cliente (empresa ou pessoa física). Toda referência a outro registro usa uma FK composta
/// com `organization_id`, garantindo no banco que ela aponta para a mesma organização.
model Customer {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  type           CustomerType
  name           String         @db.VarChar(160)
  tradeName      String?        @map("trade_name") @db.VarChar(160)
  /// CPF ou CNPJ (inclusive alfanumérico) sem pontuação.
  document       String?        @db.VarChar(14)
  email          String?        @db.VarChar(254)
  /// Somente dígitos.
  phone          String?        @db.VarChar(15)
  website        String?        @db.VarChar(200)
  city           String?        @db.VarChar(80)
  state          String?        @db.Char(2)
  status         CustomerStatus @default(LEAD)
  tags           String[]       @default([])
  notes          String?
  /// Responsável comercial (usuário com vínculo na organização).
  ownerId        String?        @map("owner_id") @db.Uuid
  /// Empresa à qual uma pessoa física está vinculada.
  companyId      String?        @map("company_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembership OrganizationMember? @relation("CustomerOwner", fields: [organizationId, ownerId], references: [organizationId, userId], onDelete: NoAction)
  company         Customer?           @relation("CustomerCompany", fields: [organizationId, companyId], references: [organizationId, id], onDelete: NoAction)
  people          Customer[]          @relation("CustomerCompany")
  deals           Deal[]
  createdBy       User?               @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts        Contact[]
  tasks           Task[]
  activities      Activity[]

  @@unique([organizationId, id])
  @@unique([organizationId, document])
  @@index([organizationId, name])
  @@index([organizationId, updatedAt])
  @@index([organizationId, ownerId])
  @@index([organizationId, status])
  @@index([organizationId, companyId])
  @@index([tags], type: Gin)
  @@map("customers")
}

/// Pessoa de contato de um cliente.
model Contact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  name           String   @db.VarChar(120)
  email          String?  @db.VarChar(254)
  phone          String?  @db.VarChar(15)
  position       String?  @db.VarChar(80)
  isPrimary      Boolean  @default(false) @map("is_primary")
  notes          String?  @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@map("contacts")
}

/// Funil de vendas da organização. Toda organização nasce com um funil padrão.
model Pipeline {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(80)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("pipelines")
}

/// Etapa do funil. Etapas de encerramento (WON/LOST) definem o status do negócio.
model PipelineStage {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  name           String    @db.VarChar(60)
  kind           StageKind @default(OPEN)
  /// Probabilidade de fechamento (0–100), usada em previsões.
  probability    Int       @default(0)
  position       Int
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  pipeline Pipeline @relation(fields: [organizationId, pipelineId], references: [organizationId, id], onDelete: Cascade)
  deals    Deal[]

  @@unique([organizationId, pipelineId, id])
  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

/// Negócio (oportunidade). A FK composta da etapa inclui organização e funil: o banco garante
/// que a etapa pertence ao mesmo funil e à mesma organização do negócio.
model Deal {
  id                String     @id @default(uuid(7)) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  pipelineId        String     @map("pipeline_id") @db.Uuid
  stageId           String     @map("stage_id") @db.Uuid
  customerId        String     @map("customer_id") @db.Uuid
  ownerId           String?    @map("owner_id") @db.Uuid
  title             String     @db.VarChar(160)
  value             Decimal    @default(0) @db.Decimal(14, 2)
  status            DealStatus @default(OPEN)
  expectedCloseDate DateTime?  @map("expected_close_date") @db.Date
  /// Ordem do card dentro da coluna (índice fracionário: inserções sem renumerar a coluna).
  position          Float      @default(0)
  notes             String?
  lostReason        String?    @map("lost_reason") @db.VarChar(500)
  closedAt          DateTime?  @map("closed_at") @db.Timestamptz(3)
  stageChangedAt    DateTime   @default(now()) @map("stage_changed_at") @db.Timestamptz(3)
  createdById       String?    @map("created_by_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline        Pipeline            @relation(fields: [organizationId, pipelineId], references: [organizationId, id], onDelete: Cascade)
  stage           PipelineStage       @relation(fields: [organizationId, pipelineId, stageId], references: [organizationId, pipelineId, id], onDelete: NoAction)
  customer        Customer            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: NoAction)
  ownerMembership OrganizationMember? @relation("DealOwner", fields: [organizationId, ownerId], references: [organizationId, userId], onDelete: NoAction)
  createdBy       User?               @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  history         DealStageHistory[]
  tasks           Task[]
  activities      Activity[]

  @@unique([organizationId, id])
  @@index([organizationId, stageId, position])
  @@index([organizationId, pipelineId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, customerId])
  @@index([organizationId, status, closedAt])
  @@map("deals")
}

/// Histórico de movimentações. Os nomes das etapas são copiados no momento da mudança, para que
/// o histórico continue legível mesmo se uma etapa for renomeada ou removida.
model DealStageHistory {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  dealId         String      @map("deal_id") @db.Uuid
  fromStageId    String?     @map("from_stage_id") @db.Uuid
  toStageId      String      @map("to_stage_id") @db.Uuid
  fromStageName  String?     @map("from_stage_name") @db.VarChar(60)
  toStageName    String      @map("to_stage_name") @db.VarChar(60)
  fromStatus     DealStatus? @map("from_status")
  toStatus       DealStatus  @map("to_status")
  lostReason     String?     @map("lost_reason") @db.VarChar(500)
  changedById    String?     @map("changed_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  deal      Deal  @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  changedBy User? @relation("DealHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([organizationId, dealId, createdAt])
  @@map("deal_stage_history")
}

// ---------------------------------------------------------------------------
// Tarefas e atividades
// ---------------------------------------------------------------------------

/// Tarefa com responsável, prazo e prioridade, opcionalmente ligada a um cliente e/ou negócio.
model Task {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String       @db.VarChar(160)
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  /// Prazo (data de calendário, sem fuso).
  dueDate        DateTime     @map("due_date") @db.Date
  /// Preenchido somente enquanto a tarefa está concluída.
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  assigneeId     String       @map("assignee_id") @db.Uuid
  customerId     String?      @map("customer_id") @db.Uuid
  /// Ao excluir o negócio, a API desfaz o vínculo antes (a tarefa continua no cliente).
  dealId         String?      @map("deal_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assigneeMembership OrganizationMember @relation("TaskAssignee", fields: [organizationId, assigneeId], references: [organizationId, userId], onDelete: NoAction)
  customer           Customer?          @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)
  deal               Deal?              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: NoAction)
  createdBy          User?              @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, assigneeId, status, dueDate])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId])
  @@index([organizationId, dealId])
  @@map("tasks")
}

/// Interação registrada (ligação, reunião, e-mail ou observação) no histórico de um cliente.
model Activity {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           ActivityType
  subject        String       @db.VarChar(160)
  description    String?
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  customerId     String       @map("customer_id") @db.Uuid
  /// Ao excluir o negócio, a API desfaz o vínculo antes (o registro continua no cliente).
  dealId         String?      @map("deal_id") @db.Uuid
  authorId       String       @map("author_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer           @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)
  deal             Deal?              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: NoAction)
  authorMembership OrganizationMember @relation("ActivityAuthor", fields: [organizationId, authorId], references: [organizationId, userId], onDelete: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, customerId, occurredAt(sort: Desc)])
  @@index([organizationId, dealId])
  @@index([organizationId, authorId])
  @@map("activities")
}
