# ---------------------------------------------------------------------------
# NEXUS CRM — API
# Copie para `apps/api/.env`. Nunca versione o arquivo `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3333

# URL pública do frontend (usada em links de e-mail) e origens autorizadas no CORS.
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Banco de dados (mesmos valores do docker-compose.yml)
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus_crm?schema=public
# Banco separado para os testes de integração (criado automaticamente pelo Docker Compose)
DATABASE_URL_TEST=postgresql://nexus:nexus_dev_password@localhost:5432/nexus_crm_test?schema=public

# Segredo para assinar tokens CSRF. Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# Duração da sessão em horas (padrão: 7 dias)
SESSION_TTL_HOURS=168
# Validade do link de redefinição de senha em minutos
PASSWORD_RESET_TTL_MINUTES=30

# Limite de requisições por minuto (geral e endpoints de autenticação)
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# Número de proxies confiáveis à frente da API (ex.: 1 atrás de um load balancer)
TRUST_PROXY=0

# Documentação Swagger em /api/docs. Omitida: ligada em desenvolvimento, desligada em produção.
SWAGGER_ENABLED=true

# Em desenvolvimento, sem SMTP, os e-mails são gravados como arquivos nesta pasta.
MAIL_OUTBOX_DIR=.mail-outbox

# Envio real de e-mails (convites e redefinição de senha). Sem SMTP_URL, nada é enviado em
# produção. Ex.: smtps://usuario:senha@smtp.exemplo.com:465
# SMTP_URL=
MAIL_FROM=NEXUS CRM <nao-responda@nexuscrm.local>

# Senha das contas de DEMONSTRAÇÃO criadas pela seed (uso exclusivamente local).
SEED_DEMO_PASSWORD=Demo@2026
