# ---------------------------------------------------------------------------
# NEXUS CRM — produção com Docker Compose (docker-compose.prod.yml)
# Copie para `.env.production`, preencha e NUNCA versione o arquivo preenchido.
# ---------------------------------------------------------------------------

# Endereço público da aplicação (links de e-mail, CORS e verificação de origem).
APP_URL=https://crm.suaempresa.com.br

# Domínio servido pelo Caddy, com certificado HTTPS automático (Let's Encrypt).
# Use ":80" para servir só HTTP atrás de outro proxy/balanceador com TLS.
SITE_ADDRESS=crm.suaempresa.com.br
HTTP_PORT=80
HTTPS_PORT=443

# Banco de dados (o PostgreSQL não publica portas: só a API o acessa).
POSTGRES_USER=nexus
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=nexus_crm

# Segredo dos tokens CSRF (mínimo de 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# E-mails de convite e de redefinição de senha. Sem SMTP_URL, nada é enviado.
# Ex.: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
MAIL_FROM=NEXUS CRM <nao-responda@suaempresa.com.br>

# Limites de requisições por minuto e por IP (geral e autenticação).
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# Documentação Swagger em /api/docs (desligada por padrão em produção).
SWAGGER_ENABLED=false

# Somente para uma DEMONSTRAÇÃO pública isolada (perfil "demo"): senha das contas fictícias.
SEED_DEMO_PASSWORD=
